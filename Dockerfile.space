FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    CORPUS_DIR=/opt/demo/corpus E5_MODEL_DIR=/opt/demo/model QUALITY_DB=/opt/demo/state/quality.sqlite3 \
    PUBLIC_DEMO=1

WORKDIR /app
COPY requirements.txt requirements-semantic.txt ./
RUN pip install --no-cache-dir -r requirements-semantic.txt
COPY app.py retrieval.py semantic.py index.html prepare_assets.py ./
RUN python prepare_assets.py --corpus /opt/demo/corpus --model /opt/demo/model \
    && useradd --create-home --uid 1000 demo \
    && install -d -o demo -g demo /opt/demo/state

USER demo
EXPOSE 7860
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7860"]
